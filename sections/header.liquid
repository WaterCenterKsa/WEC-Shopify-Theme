<header class="wec-header{% if settings.sticky_header %} is-sticky{% endif %}"><div class="wec-header__bar"><button class="wec-mobile-toggle" type="button" aria-label="Menu">☰</button><a class="wec-logo" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 380 | image_tag: loading: 'eager', alt: shop.name }}{% else %}<strong>{{ shop.name }}</strong>{% endif %}</a>{% if settings.show_search %}<div class="wec-search"><form action="{{ routes.search_url }}" method="get" role="search"><input data-predictive-input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off"><input type="hidden" name="options[prefix]" value="last"><button type="submit">⌕</button></form>{% render 'predictive-search' %}</div>{% endif %}<div class="wec-actions"><a href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Cart <span data-cart-count>{{ cart.item_count }}</span></a></div></div><nav class="wec-nav" aria-label="Main navigation"><div class="wec-nav__inner">{% for link in linklists.main-menu.links %}<div class="wec-nav__item"><a href="{{ link.url }}">{{ link.title }}</a>{% if link.links.size > 0 %}<div class="wec-mega">{% for child in link.links %}<div><div class="wec-mega__title"><a href="{{ child.url }}">{{ child.title }}</a></div>{% for grandchild in child.links %}<a href="{{ grandchild.url }}">{{ grandchild.title }}</a>{% endfor %}</div>{% endfor %}</div>{% endif %}</div>{% endfor %}</div></nav></header>