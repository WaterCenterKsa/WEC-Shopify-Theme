<div class="wec-container" style="padding:40px 0"><div class="wec-grid" style="grid-template-columns:1fr 1fr"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading:'eager', alt:product.title }}{% endif %}</div><div><h1>{{ product.title }}</h1>{% render 'price', product: product %}<div>{{ product.description }}</div>{% form 'product', product %}{% unless product.has_only_default_variant %}<select name="id">{% for v in product.variants %}<option value="{{ v.id }}">{{ v.title }} — {{ v.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<button type="submit">{{ 'products.add_to_cart' | t }}</button>{% endform %}</div></div></div>