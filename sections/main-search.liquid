<div class="wec-container" style="padding:40px 0"><h1>Search</h1><form action="{{ routes.search_url }}" method="get"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><button type="submit">Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results</p><div class="wec-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product:item %}{% endif %}{% endfor %}</div>{% endif %}</div>