<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading:'lazy', alt:product.title }}{% endif %}<h2 style="font-size:16px">{{ product.title }}</h2></a>{% render 'price', product:product %}{% if settings.enable_quick_add and product.available %}{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit">{{ 'products.quick_add' | t }}</button>{% endform %}{% endif %}</article>